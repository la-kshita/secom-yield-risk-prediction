# Keep the build context small: the raw data alone is 54 MB and the service never
# reads it. Only src/, models/ and requirements.txt belong in the image.

# Python caches and local virtual environments
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Version control and editor state
.git/
.gitignore
.ipynb_checkpoints/

# Training and evaluation material, not needed at runtime
notebooks/
tests/
data/

# Documentation and local notes
*.md
AGENTS.md

# Local environment and secrets
.env
